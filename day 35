class Solution {
    public int[] runningSum(int[] nums) {

        for(int i = 1; i < nums.length; i++){
            nums[i] += nums[i - 1];
        }

        return nums;
    }
}

class Solution {
    public void moveZeroes(int[] nums) {
        int j = 0; 
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                
                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;
                j++;   
            }
        }
    }
}
