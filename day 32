class Solution {
    public boolean helper(int x) {
        int temp = x;

        while(temp > 0) {
            int d = temp % 10;

            if(d == 0 || x % d != 0) {
                return false;
            }

            temp /= 10;
        }

        return true;
    }

    public List<Integer> selfDividingNumbers(int left, int right) {
        List<Integer> ans = new ArrayList<>();

        for(int i = left; i <= right; i++) {
            if(helper(i)) {
                ans.add(i);
            }
        }

        return ans;
    }
}
